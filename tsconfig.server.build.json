{
  // Compiles the API and its tests to JavaScript, so the tests can run on Node 18 (the host's
  // version), which can't run TypeScript: `npm run build:server && node --test build/server/`.
  // The deploy package itself is bundled by scripts/release.mjs.
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.build.tsbuildinfo",
    "noEmit": false,
    "rootDir": ".",
    "outDir": "build",
    "target": "es2022",
    "rewriteRelativeImportExtensions": true
  }
}
