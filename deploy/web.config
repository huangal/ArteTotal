<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS + iisnode configuration for ArteTotal. Every request goes to the Node app (app.cjs),
  which serves the website, the API and uploaded images.
  Needs the IIS URL Rewrite module, which hosts offering iisnode normally have installed.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="app.cjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="ArteTotal" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.cjs" />
        </rule>
      </rules>
    </rewrite>

    <!-- One Node process (it also counts wrong Studio passwords, so a single process keeps that count).
         Restart the app when server/index.js, app.cjs, this file or the settings file changes.
         devErrorsEnabled shows Node's error output in the browser; set it to "true" only while
         diagnosing a problem. Logs are written to the iisnode folder either way. -->
    <iisnode
      nodeProcessCountPerApplication="1"
      watchedFiles="web.config;app.cjs;server\index.js;artetotal.settings.json"
      loggingEnabled="true"
      devErrorsEnabled="true"
      node_env="production" />

    <!-- Let the app's own error responses (404, 409, 422...) reach the browser unchanged. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Studio uploads are up to 25 MB; IIS's default limit is about 28.6 MB. -->
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <!-- Holds the database password: never downloadable. -->
          <add segment="artetotal.settings.json" />
          <add segment="artetotal.settings.example.json" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
